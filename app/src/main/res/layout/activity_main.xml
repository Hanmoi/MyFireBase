<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:gravity="center_vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="간단 커뮤니티 앱" android:textColor="@color/board_accent" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="반가워요!" android:textAppearance="@style/BoardHeading" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="함께 이야기를 나눠 보세요." android:layout_marginBottom="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <EditText android:id="@+id/emailArea" style="@style/BoardField" android:inputType="textEmailAddress" android:hint="이메일 주소" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/pwdArea" style="@style/BoardField" android:layout_marginTop="8dp" android:inputType="textPassword" android:hint="비밀번호" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/logInBtn" android:text="로그인" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/googleLoginBtn" style="@style/Widget.Material3.Button.OutlinedButton" android:text="Google로 로그인" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/joinBtn" style="@style/Widget.Material3.Button.TextButton" android:text="회원가입" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/logoutBtn" style="@style/Widget.Material3.Button.TextButton" android:text="로그아웃" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
