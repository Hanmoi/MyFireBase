<resources>
    <color name="board_canvas">#F3F6F2</color>
    <color name="board_surface">#FFFFFF</color>
    <color name="board_accent">#176552</color>
    <color name="board_on_accent">#FFFFFF</color>
    <color name="board_line">#C7D5CE</color>
    <style name="BoardHeading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="BoardField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/board_panel</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
