<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:padding="16dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="게시글" android:textAppearance="@style/BoardHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/writeBtn" android:text="＋ 글쓰기" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <ListView android:id="@+id/lv" android:paddingHorizontal="16dp" android:paddingBottom="16dp" android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="8dp" android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
